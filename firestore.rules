rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Venues: Publicly readable; allow updates/writes
    match /venues/{venueId} {
      allow read: if true;
      allow write, update, delete: if true;
    }

    // Bookings: Publicly readable for live schedule matrix;
    // Allow create, update (revocation/cancellation), and delete (purging)
    match /bookings/{bookingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Allowed Users (Whitelist of authorized organizer emails):
    // Allow read, add, update, and delete (revoking authorization)
    match /allowed_users/{email} {
      allow read: if true;
      allow create, write, update, delete: if true;
    }

    // Settings (Auth policy, strict mode)
    match /settings/{settingId} {
      allow read: if true;
      allow write, update: if true;
    }

    // Club Profiles: Publicly readable; allow write/update
    match /clubs/{clubId} {
      allow read: if true;
      allow create, write, update, delete: if true;
    }

    // Activity & Change Audit Logs: Publicly readable for admin oversight; allow create/update/delete
    match /activity_logs/{logId} {
      allow read: if true;
      allow create, write, update, delete: if true;
    }

    // Union Members: Publicly readable; allow create/update/delete
    match /union_members/{memberId} {
      allow read: if true;
      allow create, write, update, delete: if true;
    }

    // Complaints & Suggestions: Publicly readable; allow create/update/delete
    match /complaints_suggestions/{itemId} {
      allow read: if true;
      allow create, write, update, delete: if true;
    }

    // Class Representatives: Publicly readable; allow create/update/delete
    match /class_representatives/{repId} {
      allow read: if true;
      allow create, write, update, delete: if true;
    }
  }
}


